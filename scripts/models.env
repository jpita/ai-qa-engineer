# The model pin for the comparison. One place, sent explicitly to every CLI call —
# never left to a CLI default, which drifts silently between runs.
#
# Verified working 2026-09-03 (each ID confirmed live against its own CLI):
MODEL_CLAUDE="claude-sonnet-5"
MODEL_CODEX="gpt-5.6-luna"
MODEL_GROK="grok-4.6"
MODEL_KIMI="moonshotai/kimi-k2.7-code"      # kimi needs the provider/ prefix, plain "kimi-k2.7-code" is rejected
MODEL_DEEPSEEK="deepseek-flash"
MODEL_ANTIGRAVITY="gemini-3.6-flash"
ANTIGRAVITY_EFFORT="high"                    # agy requires --effort whenever --model is set
