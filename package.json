{
  "name": "ai-qa-engineer",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent that tests a web app the way a QA engineer does, and reports only the bugs it proved",
  "type": "module",
  "scripts": {
    "crawl": "tsx scripts/crawl.ts",
    "coverage": "tsx scripts/coverage.ts",
    "run-specs": "tsx scripts/run.ts",
    "report": "tsx scripts/report.ts",
    "validate": "tsx scripts/validate.ts",
    "app:up": "docker compose up -d --wait",
    "app:down": "docker compose down -v",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:demo": "tsx scripts/evals/run.ts --demo",
    "eval:run": "tsx scripts/evals/run.ts",
    "bug-report": "tsx scripts/bug-report.ts",
    "harbor:prepare": "tsx scripts/evals/harbor-prepare.ts",
    "harbor:oracle": "npm run harbor:prepare && harbor run -p \"$PWD/runs/harbor/tasks\" -a oracle -n 1 -o \"$PWD/runs/harbor/jobs\"",
    "harbor:nop": "npm run harbor:prepare && harbor run -p \"$PWD/runs/harbor/tasks\" -a nop -n 1 -o \"$PWD/runs/harbor/jobs\"",
    "harbor:view": "harbor view runs/harbor/jobs --port 8080",
    "harbor:compare": "bash scripts/evals/harbor-compare.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpita/ai-qa-engineer.git"
  },
  "homepage": "https://github.com/jpita/ai-qa-engineer#readme",
  "bugs": {
    "url": "https://github.com/jpita/ai-qa-engineer/issues"
  },
  "author": "Gabriel Pita",
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "ai-agent",
    "claude-code",
    "skill"
  ]
}
